# ---------------------------------------------------------------------------
# Smart School Management System — environment variables
# Copy to .env.local (never commit .env.local).
# ---------------------------------------------------------------------------

# Written automatically by `npx convex dev` when you link a Convex project.
# CONVEX_DEPLOYMENT=dev:your-deployment-name

# Public URL of the Convex deployment. When unset, the UI runs on the Stage 1
# mock services and Convex/Convex Auth are not mounted.
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Self-hosted / local backend alternative to CONVEX_DEPLOYMENT:
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=...

# ---------------------------------------------------------------------------
# Set on the CONVEX DEPLOYMENT (npx convex env set NAME value), not here:
#   JWT_PRIVATE_KEY, JWKS   — generated by `npx @convex-dev/auth`
#   SITE_URL                — e.g. http://localhost:3000
#   ALLOW_DEMO_SEED=true    — development deployments only; enables seed:demo
# ---------------------------------------------------------------------------
